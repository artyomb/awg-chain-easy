COMPOSE_PROJECT_NAME=awg-chain-easy
AWG_IMAGE=amneziavpn/amneziawg-go:3.1.20260828@sha256:cbafc02b8373a83f428272db6d8001b37bc02e6211cbd8c0cb4e2e3759b12b72
WIREGUARD_GO_COMMIT=f333402bd9cbe0f3eeb02507bd14e23d7d639280
APP_IMAGE=awg-chain-easy:local
CONTAINER_NAME=awg-chain-easy

# Fixed upstream ports for peers that initiate connections back to this server.
# Keep this 1-8 port range separate from all inbound UDP ports and DNS port 53.
UPSTREAM_BIND_ADDRESS=0.0.0.0
UPSTREAM_PORT_RANGE=54323-54330

# awg-easy-compatible settings.
WG_HOST=vpn.example.com
# Initial GUI server name; saved GUI settings take precedence afterwards.
VPN_SERVER_NAME=Server A
# AWG3 only. Existing interfaces are not automatically migrated.
AWG3_RANDOM_TRAILERS=off
AWG3_DISABLE_COOKIES=off
WG_PORT=51820
WG_CONFIG_PORT=51820
WG_DEFAULT_ADDRESS=10.8.3.x
WG_DEFAULT_DNS=auto
AWG2_PORT=51822
AWG2_CONFIG_PORT=51822
AWG2_DEFAULT_ADDRESS=10.8.4.x
AWG2_DEFAULT_DNS=auto
AWG2_JC=6
AWG2_JMIN=10
AWG2_JMAX=50
AWG2_S1=64
AWG2_S2=56
AWG2_S3=19
AWG2_S4=4
AWG2_I1='<r 2><b 0x858000010001000000000669636c6f756403636f6d0000010001c00c000100010000105a00044d583737>'

# Native WireGuard inbound.
NATIVE_WG_PORT=51823
NATIVE_WG_CONFIG_PORT=51823
NATIVE_WG_DEFAULT_ADDRESS=10.8.5.x
NATIVE_WG_DEFAULT_DNS=auto

# Optional Amnezia client split-tunneling recognition: 0.0.0.0/0, ::/0
# The server routing dataplane remains IPv4-only.
WG_ALLOWED_IPS=0.0.0.0/0
WG_PERSISTENT_KEEPALIVE=25
WG_MTU=1280
WG_DEVICE=eth0

# Web UI. Keep loopback binding unless a TLS reverse proxy protects the UI.
PORT=51821
WEBUI_BIND_ADDRESS=127.0.0.1
# Enable only when all browser access uses an HTTPS reverse proxy.
WEBUI_HTTPS=false
# Comma-separated exact peer IPs allowed to supply X-Forwarded-For; no CIDRs.
TRUSTED_PROXY_IPS=
PASSWORD_HASH=
MAX_AGE=720
CONFIG_DIR=./config

# DNS policy resolver. Domain policies require clients to use the local DNS.
DNS_UPSTREAM=1.1.1.1
DNS_TTL_MIN=30
DNS_TTL_MAX=86400

# AWG 3 camouflage and header protection.
JC=6
JMIN=64
JMAX=128
S1=64
S2=56
S3=32
S4=16
CONTENT_PADDING_ADDITION=0-32
REKEY_AFTER_TIME=110-130
REKEY_TIMEOUT=4-6
REJECT_AFTER_TIME=170-190
KEEPALIVE_TIMEOUT=8-12
MAX_HANDSHAKE_ATTEMPTS=15-20
I1='<r 2><b 0x858000010001000000000669636c6f756403636f6d0000010001c00c000100010000105a00044d583737>'
