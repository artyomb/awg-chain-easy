COMPOSE_PROJECT_NAME=awg-chain-easy
AWG_IMAGE=amneziavpn/amneziawg-go:3.0.20260805
APP_IMAGE=awg-chain-easy:local
CONTAINER_NAME=awg-chain-easy

# awg-easy-compatible settings.
WG_HOST=vpn.example.com
WG_PORT=51820
WG_CONFIG_PORT=51820
WG_DEFAULT_ADDRESS=10.8.3.x
WG_DEFAULT_DNS=auto
AWG2_PORT=51822
AWG2_CONFIG_PORT=51822
AWG2_DEFAULT_ADDRESS=10.8.4.x
AWG2_DEFAULT_DNS=auto
AWG2_JC=6
AWG2_JMIN=10
AWG2_JMAX=50
AWG2_S1=64
AWG2_S2=56
AWG2_S3=19
AWG2_S4=4
AWG2_I1='<r 2><b 0x858000010001000000000669636c6f756403636f6d0000010001c00c000100010000105a00044d583737>'
WG_ALLOWED_IPS=0.0.0.0/0
WG_PERSISTENT_KEEPALIVE=25
WG_MTU=1280
WG_DEVICE=eth0

# Web UI. Keep loopback binding unless a TLS reverse proxy protects the UI.
PORT=51821
WEBUI_BIND_ADDRESS=127.0.0.1
PASSWORD_HASH=
MAX_AGE=720
CONFIG_DIR=./config

# DNS policy resolver. Domain policies require clients to use the local DNS.
DNS_UPSTREAM=1.1.1.1
DNS_TTL_MIN=30
DNS_TTL_MAX=86400

# AWG 3 camouflage and header protection.
JC=6
JMIN=64
JMAX=128
S1=64
S2=56
S3=32
S4=16
CONTENT_PADDING_ADDITION=0-32
REKEY_AFTER_TIME=110-130
REKEY_TIMEOUT=4-6
REJECT_AFTER_TIME=170-190
KEEPALIVE_TIMEOUT=8-12
MAX_HANDSHAKE_ATTEMPTS=15-20
I1='<r 2><b 0x858000010001000000000669636c6f756403636f6d0000010001c00c000100010000105a00044d583737>'
